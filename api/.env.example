# Copy this file to .env in the same folder (api/.env) and fill in real values.
# .env is gitignored on purpose -- never commit real secrets.

# MongoDB connection string. Free tier works fine:
# https://www.mongodb.com/cloud/atlas/register -> create a free cluster ->
# "Connect" -> "Drivers" -> copy the connection string and put your DB
# user's password in it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rehaish

# Any long random string, used to sign login (JWT) tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# --- Email (used to send the sign-up verification code) ---
# Easiest option: a Gmail account with an "App Password" (not your normal
# Gmail password -- Google requires 2FA enabled, then generate one at
# https://myaccount.google.com/apppasswords). Any SMTP provider works too
# (SendGrid, Mailgun, etc.) -- just point EMAIL_HOST/PORT at it instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
